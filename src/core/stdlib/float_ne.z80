; float_ne.z80 - IEEE 754 float not-equal comparison
;
; Function: _float_ne(a_ptr, b_ptr)
; Returns 1 if a != b, 0 otherwise
;
; Calling convention (new_sdcc):
;   A = pointer to float a
;   L = pointer to float b
;   Return: A = 1 (not equal) or 0 (equal)

_float_ne:
  ; Load a bytes
  ld hl, (a)
  ld de, (hl)
  inc hl
  inc hl
  ld a, (hl)
  push af
  inc hl
  ld b, (hl)

  ; Load b bytes
  ld hl, (l)
  ld a, (hl)
  ld d, a
  inc hl
  ld a, (hl)
  ld e, a
  inc hl
  ld a, (hl)
  ld h, a
  inc hl
  ld a, (hl)
  ld l, a

  ; Compare all bytes. If any differ, return 1.
  ld a, b
  cp l
  jr nz, _fn_yes
  pop a
  cp h
  jr nz, _fn_yes
  ld a, d
  cp e
  jr nz, _fn_yes
  ld a, e
  cp d
  jr nz, _fn_yes

  ; All equal
  xor a; ret

_fn_yes:
  ld a, 1; ret
