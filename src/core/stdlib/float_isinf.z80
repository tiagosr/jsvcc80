; float_isinf.z80 - IEEE 754 Infinity detection
;
; Function: _float_isinf
; Returns 1 if operand is +/- Infinity, 0 otherwise
;
; Calling convention (new_sdcc):
;   Entry: A = pointer to float operand (address byte)
;   Exit: A = 1 (Infinity) or 0 (not Infinity)

_float_isinf:
  ; Load operand bytes
  ld hl, (a)          ; HL = bytes 0-1
  inc hl
  inc hl
  ld a, (hl)          ; A = byte 2
  inc hl
  ld b, (hl)          ; B = byte 3

  ; Infinity: exponent = 0xFF, mantissa = 0
  ; exponent = 0xFF => byte3 & 0x7F = 0x7F AND byte2 & 0x80 = 0x80
  ld a, b
  and $7F
  cp $7F
  jr nz, _isinf_not

  ld a, a
  and $80
  cp $80
  jr nz, _isinf_not

  ; exponent = 0xFF. Check mantissa = 0.
  ld a, l
  or e
  jr nz, _isinf_not   ; mantissa != 0 -> not infinity (would be NaN)

  ld a, a
  and $7F
  or a
  jp nz, _isinf_not

_isinf_not:
  xor a               ; A = 0
  ret

_isinf_yes:
  ld a, 1             ; A = 1
  ret
