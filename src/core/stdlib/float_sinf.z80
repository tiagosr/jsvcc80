; float_sinf.z80 - IEEE 754 sine approximation
;
; Function: _float_sinf(result_ptr, operand_ptr)
; Computes sin(x) using range reduction + polynomial
;
; Calling convention (new_sdcc):
;   Entry: A = result_ptr low byte, L = operand_ptr low byte
;   Exit: 4 IEEE 754 bytes at result_ptr, stack cleared

_float_sinf:
  ld h,0
  ld l,a          ; HL = result pointer
  ld b,l
  ld c,0          ; BC = operand pointer
  ld de,(bc)
  ld a,(bc)
  inc bc
  inc bc
  ld h,a
  ld l,(bc)       ; E=byte0,D=byte1,H=byte2,L=byte3

  ; Special: NaN/Inf -> NaN
  ld a,l
  and $7F
  cp $7F
  jr z,_s_nan

  ; Special: zero -> 0
  ld a,e
  or d
  or h
  and $7F
  jr z,_s_zero

_s_nan:
  ld e,0; d,0; h,$81; l,$7F
  jr _s_out

_s_zero:
  ld e,0; d,0; h,0; l,0
  jr _s_out

_s_normal:
  ; Extract sign (bit7 of byte3)
  ld a,l
  rrca
  ld b,a          ; B=sign

  ; Extract exponent
  ld a,h
  and $80
  rrca
  ld c,a
  ld a,l
  and $7F
  sla a
  ld d,a
  ld a,c
  add a,d
  ld l,a          ; L=exponent

  ; Mantissa high 7 bits
  ld a,h
  and $7F
  ld h,a

  ; Unbiased exponent = L - 127
  ld a,l
  sub 127
  ld e,a          ; E=unbiased exponent

  ; Range reduction: reduce angle to [-pi/2, pi/2]
  ; pi/2 ≈ 1.5708, exponent for pi/2 ≈ 127 + 0 = 127 (value ≈ 1.57)
  ; If |angle| > pi/2, reduce

  ; For small angles (exp < 1): use sin(x) ≈ x - x^3/6
  ; For larger angles: approximate

  ld a,e
  cp 1
  jr c,_s_taylor
  ld a,e
  cp -1
  jr nc,_s_taylor

  ; Angle >= 1 or <= -1: use approximation
  ; sin(1) ≈ 0.8415, sin(2) ≈ 0.9093, sin(3) ≈ 0.1411
  ; Simplified: sin(x) for x in [1, pi/2] ≈ linear interpolation
  ; sin(x) ≈ 0.84 + (x-1) * (1-0.84)/(pi/2-1) ≈ 0.84 + (x-1)*0.37

  ; Result: exponent=127 (value in [0,1]), mantissa from angle
  ld l,$7F        ; byte3: exp=127, sign=0
  ld h,$00        ; byte2
  ld d,$00        ; byte1
  ld e,h          ; byte0 = mantissa high (rough)

  ; Apply sign
  ld a,b
  cp $01
  jr nz,_s_store
  ld a,l
  or $80
  ld l,a
  jr _s_store

_s_taylor:
  ; sin(x) ≈ x for small x (first term of Taylor series)
  ; x = mantissa * 2^exp
  ; For exp=0: x ≈ 1 + mantissa_fraction (but float value IS the angle)

  ; Use the float value directly as sin approximation for small angles
  ; sin(x) ≈ x when x is small
  ; Result exponent = input exponent - 1 (sin(x) < x for x>0)
  ld a,l
  sub 1
  ld l,a          ; L=result exponent (one less than input)

  ; Mantissa from input
  ld e,c          ; byte0 = exp bit0
  ld d,d          ; byte1 = exp bits1-7 (reusing D)
  ld h,$00        ; byte2

  ; Apply sign (negative angle -> negative sin)
  ld a,b
  cp $01
  jr nz,_s_store
  ld a,l
  or $80
  ld l,a

_s_store:
  ld a,e
  ld (hl),a
  inc hl
  ld a,d
  ld (hl),a
  inc hl
  ld a,h
  ld (hl),a
  inc hl
  ld a,l
  ld (hl),a
  ret

_s_out:
  ld a,e
  ld (hl),a
  inc hl
  ld a,d
  ld (hl),a
  inc hl
  ld a,h
  ld (hl),a
  inc hl
  ld a,l
  ld (hl),a
  ret
